<mujoco model="panda_scene">

  <include file="panda_no_hand.xml"/>
  <!-- <include file="torque_actuators_no_hand.xml"/> -->
  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"  ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
        height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
        rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
        reflectance="0.2"/>
  </asset>

  <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
        <geom name="wall" type="box" size="0.1 8 8" pos="0.78 0.0 0" rgba="0.8 0.8 0.8 1" solref="0.2 1" solimp="0.0001 0.1 0.5 0 3" friction="0.25 0.0 0.0"/>
        <site name="target_site" pos="0.65 0.0 0.8" euler="3.14 1.57 0.0" rgba="1 0 0 0"/>
        <camera name="cam" pos="0.5 -1.5 3.75" euler="0.6 0.4 0.0" fovy="45" mode="fixed"/>
  </worldbody>

</mujoco>
